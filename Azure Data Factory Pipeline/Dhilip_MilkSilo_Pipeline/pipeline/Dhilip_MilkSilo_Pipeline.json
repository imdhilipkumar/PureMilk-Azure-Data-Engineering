                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT last_processed_time\nFROM dbo.Dhilip_watermark_MilkSilo\nWHERE source_name = 'MILK_SILO';",
