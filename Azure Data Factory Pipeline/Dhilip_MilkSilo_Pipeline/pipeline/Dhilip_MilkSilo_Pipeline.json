                                        "typeProperties": {
                                            "variableName": "VMaxTime",
                                            "value": {
                                                "value": "@concat(\n    substring(split(item().name,'_')[1],0,4),'-',\n    substring(split(item().name,'_')[1],4,2),'-',\n    substring(split(item().name,'_')[1],6,2),'T',\n    substring(split(item().name,'_')[2],0,2),':',\n    substring(split(item().name,'_')[2],2,2),':00'\n)",
                                                "type": "Expression"
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
