                "typeProperties": {
                    "variableName": "VMaxTime",
                    "value": {
                        "value": "@if(\n    empty(string(activity('LkMilkSilo').output.firstRow.last_processed_time)),\n    '1900-01-01T00:00:00',\n    string(activity('LkMilkSilo').output.firstRow.last_processed_time)\n)",
