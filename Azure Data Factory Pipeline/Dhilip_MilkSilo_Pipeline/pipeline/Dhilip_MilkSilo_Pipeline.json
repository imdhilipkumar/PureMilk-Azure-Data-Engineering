                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@if(\n    startsWith(item().name,'milksilo_'),\n    and(\n        greater(\n            ticks(\n                concat(\n                    substring(split(item().name,'_')[1],0,4),'-',\n                    substring(split(item().name,'_')[1],4,2),'-',\n                    substring(split(item().name,'_')[1],6,2),'T',\n                    substring(split(item().name,'_')[2],0,2),':',\n                    substring(split(item().name,'_')[2],2,2),':00'\n                )\n            ),\n            ticks(activity('LkMilkSilo').output.firstRow.last_processed_time)\n        ),\n        lessOrEquals(\n            ticks(\n                concat(\n                    substring(split(item().name,'_')[1],0,4),'-',\n                    substring(split(item().name,'_')[1],4,2),'-',\n                    substring(split(item().name,'_')[1],6,2),'T',\n                    substring(split(item().name,'_')[2],0,2),':',\n                    substring(split(item().name,'_')[2],2,2),':00'\n                )\n            ),\n            ticks(variables('VBatchEnd'))\n        )\n    ),\n    false\n)",
                        "type": "Expression"
                    }
                }
